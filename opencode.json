{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "git *": "allow",
      "npm run *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "rm -rf *": "deny",
      "*": "ask"
    },
    "edit": "allow",
    "external_directory": {
      "**/node_modules/**": "deny",
      "**/.next/**": "deny",
      "*": "allow"
    }
  }
}
